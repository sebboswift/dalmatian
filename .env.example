# Spark master used by the API and async workers. Use local[*] only for local development.
DALMATIAN_SPARK_MASTER=spark://spark-master:7077
DALMATIAN_SPARK_APP_NAME=dalmatian

# Bound each long-lived Dalmatian Spark application so one API pod or async worker cannot take the cluster.
# The bundled Compose cluster has four total cores; two keeps one driver from monopolizing it.
DALMATIAN_SPARK_APP_MAX_CORES=2
DALMATIAN_SPARK_EXECUTOR_CORES=2
DALMATIAN_SPARK_EXECUTOR_MEMORY=2g
# Optional fixed executor count. Leave unset to let the Spark deployment decide how executors are allocated.
DALMATIAN_SPARK_EXECUTOR_INSTANCES=

# Valkey is the coordination plane for exact-result caching, job queues, leases, retries, idempotency, and output publication fencing.
DALMATIAN_VALKEY_URL=valkey://valkey:6379/0

# Local source files are resolved below this directory when a source does not name a location.
DALMATIAN_DATA_ROOT=/data

# Optional named remote input roots. Query bodies name the key, never an arbitrary cloud URI.
# Example: {"lake":"s3a://company-data/warehouse","gcs":"gs://company-data/warehouse"}
DALMATIAN_SOURCE_LOCATIONS={}

# Approved output roots for store mode. S3 is normalized to s3a for Spark's Hadoop connector.
DALMATIAN_STORAGE_LOCATIONS={"local":"file:///exports"}

# Valkey keys under this prefix are the authoritative logical output pointers for error/overwrite publication.
# Attempt data and manifests stay immutable in object storage. Changing this prefix makes old pointers invisible.
DALMATIAN_OUTPUT_PUBLICATION_PREFIX=dalmatian:outputs

# Optional audit/config database. PostgreSQL and MySQL are supported through SQLAlchemy.
# Run `dalmatian-admin metadata-upgrade` before starting services with this value set.
# PostgreSQL: postgresql+psycopg://dalmatian:password@postgres:5432/dalmatian
# MySQL:      mysql+pymysql://dalmatian:password@mysql:3306/dalmatian
DALMATIAN_METADATA_URL=

# Exact inline result caching. Entries larger than RESULT_CACHE_MAX_BYTES are not cached.
DALMATIAN_DEFAULT_CACHE_TTL_SECONDS=300
DALMATIAN_MAX_CACHE_TTL_SECONDS=3600
DALMATIAN_RESULT_CACHE_MAX_BYTES=4194304
DALMATIAN_RESULT_CACHE_SINGLEFLIGHT_WAIT_SECONDS=15
DALMATIAN_RESULT_CACHE_LOCK_SECONDS=120

# Inline responses are bounded by both rows and serialized bytes. Large results should stream or store.
DALMATIAN_RESULT_ROW_LIMIT=10000
DALMATIAN_MAX_INLINE_BYTES=8388608

# Spark DISK_ONLY dataset reuse avoids making source size an executor-heap constraint.
# Exact-result caching is cluster-wide, while this dataset cache is local to one Spark application.
DALMATIAN_DATASET_CACHE_ENTRIES=32
DALMATIAN_DATASET_CACHE_TTL_SECONDS=1800

# Admission control keeps one Dalmatian driver from flooding Spark with concurrent actions.
DALMATIAN_MAX_CONCURRENT_QUERIES=4
DALMATIAN_ADMISSION_WAIT_SECONDS=0.25
DALMATIAN_DEFAULT_QUERY_TIMEOUT_SECONDS=300
DALMATIAN_MAX_QUERY_TIMEOUT_SECONDS=3600

# Async job records and Idempotency-Key bindings expire independently. Keep the idempotency TTL at least as long as the job TTL.
DALMATIAN_QUEUE_NAME=dalmatian:jobs
DALMATIAN_JOB_TTL_SECONDS=86400
DALMATIAN_IDEMPOTENCY_TTL_SECONDS=86400

# Worker leases provide at-least-once execution. Stale attempts cannot publish a stored result after ownership changes.
DALMATIAN_JOB_LEASE_SECONDS=60
DALMATIAN_WORKER_REAP_INTERVAL_SECONDS=15
DALMATIAN_WORKER_MAX_ATTEMPTS=3
DALMATIAN_WORKER_RETRY_BASE_SECONDS=2
DALMATIAN_WORKER_RETRY_MAX_SECONDS=60
DALMATIAN_MAX_QUEUE_DEPTH=10000

# Affinity shards keep repeat async jobs for the same source set near the same long-lived worker. Idle workers may steal.
DALMATIAN_WORKER_AFFINITY_SHARDS=8
# Usually leave unset. StatefulSet and Docker hostnames are mapped to a preferred shard automatically.
DALMATIAN_WORKER_AFFINITY_SHARD=

# Async workers expose Prometheus metrics separately from the API process.
DALMATIAN_WORKER_METRICS_HOST=0.0.0.0
DALMATIAN_WORKER_METRICS_PORT=9090

# Add Hadoop filesystem connector coordinates here for S3A, GCS, or ABFS when the Spark image lacks them.
DALMATIAN_SPARK_PACKAGES=
# Spark and spark.hadoop.* settings as JSON. Prefer workload identity or secrets for credentials.
DALMATIAN_SPARK_CONFIG={}

DALMATIAN_LOG_LEVEL=INFO
